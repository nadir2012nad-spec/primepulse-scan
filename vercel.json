{
  "rewrites": [
    {
      "source": "/scan/:chain/:id*",
      "destination": "/api/scan"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=20, stale-while-revalidate=40"
        }
      ]
    }
  ]
}